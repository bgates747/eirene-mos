@@ -26,6 +26,7 @@
 			
 			XREF	UART0_serial_RX
 			XREF	UART0_serial_TX
+			XREF	fill_uart0_tx_fifo
 			XREF	mos_api
 			XREF	vdp_protocol			
 			
@@ -61,6 +62,15 @@ _vblank_handler:	DI
 ;
 _uart0_handler:		DI
 			PUSH		AF
+			; examine interrupt identification register to see if it's
+			; a fifo-empty interrupt
+			in0 a,(UART0_IIR)
+			and 0xe
+			cp 2
+			; Is a fifo-empty interrupt
+			jp z,fill_uart0_tx_fifo
+
+			; Receive-data-ready interrupt
 			PUSH		BC
 			PUSH		DE
 			PUSH		HL
diff --git a/src/mos_api.asm b/src/mos_api.asm
index 7c5fabe..8ed8ab4 100644
--- a/src/mos_api.asm
+++ b/src/mos_api.asm
@@ -80,6 +80,7 @@
 
 			XREF	_open_UART1		; In uart.c
 			XREF	_close_UART1
+			XREF	uart0_async_send
 
 			XREF	UART1_serial_GETCH	; In serial.asm
 			XREF	UART1_serial_PUTCH
@@ -194,8 +195,8 @@ mos_api_block1_start:	DW	mos_api_getkey		; 0x00
 			DW	mos_api_i2c_read	; 0x22
 			DW	mos_api_unpackrtc	; 0x23
 			DW	mos_api_flseek_p	; 0x24
+			DW	mos_api_uart0_async_send; 0x25
 
-			DW	mos_api_not_implemented	; 0x25
 			DW	mos_api_not_implemented	; 0x26
 			DW	mos_api_not_implemented	; 0x27
 
@@ -1069,6 +1070,19 @@ mos_api_flseek_p:	CALL	FIX_HLU24	; Fix the HLU to ensure it's a 24-bit pointer
 			POP	HL
 			RET
 
+; Asynchronously write data to UART0 (TX interrupt based)
+;   HL: data pointer
+;   DE: completion callback
+;   BC: data length bytes
+; Returns:
+;   A: zero
+; Will return immediately, and the callback (de) will be called once transfer completes.
+; The callback must preserve IX,IY but may stomp other registers.
+; In Z80-mode the callback must return with `ret.lis`.
+mos_api_uart0_async_send:
+			CALL FIX_HLU24
+			CALL uart0_async_send
+			RET
 
 ; MOS String functions
 ;
diff --git a/src/serial.asm b/src/serial.asm
index 6f869dc..f732ad5 100644
--- a/src/serial.asm
+++ b/src/serial.asm
@@ -16,6 +16,11 @@
 
 			.ASSUME	ADL = 1
 			
+			.bss
+uart0_tx_data_pos:		.ds 3
+uart0_tx_data_count:		.ds 3
+uart0_tx_callback: 		.ds 5	; call + 3 bytes + ret OR sis-prefix + call + 2 bytes + ret
+
 			.text
 			
 			XDEF	UART0_serial_TX
@@ -33,6 +38,8 @@
 			
 			XDEF	putch 		
 			XDEF	getch 
+		 	XDEF	fill_uart0_tx_fifo
+			XDEF	uart0_async_send
 
 			XREF	_serialFlags	; In globals.asm
 				
@@ -278,3 +285,105 @@ getch:			PUSH	IY				; Standard C prologue
 			LD 	SP, IY				; Standard epilogue
 			POP	IY
 			RET
+
+			.macro WAIT_CTS
+			1:
+				in0 a,(PD_DR)
+				tst a,8
+				jr nz,1b
+			.endm
+
+
+; hl:data, bc:length, de:completion callback
+uart0_async_send:
+			ld (uart0_tx_data_pos),hl
+			ld (uart0_tx_data_count),bc
+
+			ld a,mb
+			or a
+			jr nz,.setup_z80_uart0_callback
+
+			; Setup ADL callback (no call (hl))
+			ld hl,uart0_tx_callback
+			ld a,0xcd  ; CALL
+			ld (hl),a
+			inc hl
+			ld (hl),de
+			inc hl
+			inc hl
+			inc hl
+			ld a,0xc9  ; RET
+			ld (hl),a
+			jr 1f
+
+		.setup_z80_uart0_callback:
+			; Setup Z80 mixed-mode callback (no call (hl))
+			ld hl,uart0_tx_callback
+			ld a,0x40  ; SIS prefix
+			ld (hl),a
+			inc hl
+			ld a,0xcd  ; CALL
+			ld (hl),a
+			inc hl
+			ld (hl),e
+			inc hl
+			ld (hl),d
+			inc hl
+			ld a,0xc9  ; RET
+			ld (hl),a
+
+		1:
+			; enable FIFO-empty interrupt on uart0
+			in0 a,(UART0_IER)
+			or 2
+			out0 (UART0_IER),a
+			ret
+
+; Interrupt-driven UART0 transmission
+fill_uart0_tx_fifo:
+			push bc
+			push de
+			push hl
+
+			ld bc,16
+			ld hl,(uart0_tx_data_count)
+			or a
+			sbc hl,bc
+
+			jr z,.last_fill
+			jr c,.last_fill
+
+			; send 16 bytes
+			ld (uart0_tx_data_count),hl
+			ld hl,(uart0_tx_data_pos)
+			ld de,UART0_THR
+			WAIT_CTS
+			otirx
+			ld (uart0_tx_data_pos),hl
+			pop hl
+			pop de
+			pop bc
+			pop af	; saved by _uart0_handler
+			ei
+			reti.lil
+
+		.last_fill:
+			; send <=16 final bytes
+			ld bc,(uart0_tx_data_count)
+			ld hl,(uart0_tx_data_pos)
+			ld de,UART0_THR
+			WAIT_CTS
+			otirx
+
+			; disable interrupt since send is finished
+			in0 a,(UART0_IER)
+			and 0xfd
+			out0 (UART0_IER),a
+
+			call uart0_tx_callback
+			pop hl
+			pop de
+			pop bc
+			pop af	; saved by _uart0_handler
+			ei
+			reti.lil
