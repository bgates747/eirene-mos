; SPDX-License-Identifier: MIT -- C adapters for the actual ring unit test only.
.assume adl=1
.text
.global _test_append,_test_clear_off,_test_clear_on
.extern kbuf_append,_kbuf_clear
_test_append:
 ld hl,3
 add hl,sp
 ld de,(hl)
 call kbuf_append
 ld a,0
 ret z
 inc a
 ret
_test_clear_off:
 di
 call _kbuf_clear
 ld a,i
 ld a,0
 jp po,test_off_result
 inc a
 test_off_result:
 ei
 ret
_test_clear_on:
 ei
 call _kbuf_clear
 ld a,i
 ld a,0
 jp po,test_on_result
 inc a
 test_on_result:
 ei
 ret
